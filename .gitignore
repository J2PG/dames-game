<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>J2PG Casino — Premium</title>
  <style>
    :root {
      --bg-1: #090a0e;
      --bg-2: #17151a;
      --bg-3: #2a1116;
      --panel: rgba(18, 17, 20, 0.94);
      --panel-2: rgba(28, 22, 24, 0.94);
      --red: #ff3b4d;
      --red-2: #b21427;
      --gold: #ffd77a;
      --gold-2: #ffb74d;
      --white: #f8f1ee;
      --muted: #ccb8b7;
      --green: #9cf5b5;
      --shadow: rgba(0, 0, 0, 0.72);
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      min-height: 100vh;
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      background:
        radial-gradient(circle at 50% 12%, rgba(255, 69, 82, 0.18), transparent 18%),
        radial-gradient(circle at 80% 80%, rgba(159, 18, 32, 0.22), transparent 24%),
        linear-gradient(180deg, #090a0e 0%, #120d10 30%, #090a0d 100%);
      color: var(--white);
      display: grid;
      place-items: center;
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background:
        repeating-linear-gradient(
          0deg,
          rgba(255,255,255,0.015),
          rgba(255,255,255,0.015) 1px,
          transparent 1px,
          transparent 3px
        );
      pointer-events: none;
      opacity: 0.5;
    }

    .slot {
      position: relative;
      width: min(95vw, 1100px);
      border-radius: 30px;
      overflow: hidden;
      background: rgba(9,11,15,0.96);
      border: 1px solid rgba(255, 90, 100, 0.5);
      box-shadow:
        0 0 0 1px rgba(255,255,255,0.04),
        0 30px 90px rgba(0,0,0,0.8),
        0 0 45px rgba(255, 59, 77, 0.12);
    }

    .slot::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at center, transparent 45%, rgba(0,0,0,0.38) 100%);
      pointer-events: none;
    }

    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 22px 28px 8px;
      position: relative;
      z-index: 1;
    }

    .brand {
      letter-spacing: 0.28em;
      text-transform: uppercase;
      font-size: 0.72rem;
      color: var(--red);
      font-weight: 900;
    }

    .title-wrap {
      text-align: center;
      flex: 1;
    }

    h1 {
      margin: 0;
      font-size: clamp(2.2rem, 7vw, 4rem);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      line-height: 1;
      color: #f7e9df;
      text-shadow:
        0 0 20px rgba(255, 93, 106, 0.55),
        0 4px 0 rgba(104, 24, 32, 0.9);
    }

    .subtitle {
      margin-top: 10px;
      font-size: 0.72rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .hud {
      display: grid;
      grid-template-columns: repeat(3, minmax(120px, 1fr));
      gap: 12px;
      padding: 0 22px 16px;
      position: relative;
      z-index: 1;
    }

    .hud-box {
      background: linear-gradient(180deg, rgba(30, 25, 28, 0.92), rgba(12, 12, 16, 0.92));
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 16px;
      padding: 12px 16px;
      box-shadow: inset 0 0 18px rgba(0,0,0,0.3);
      color: var(--muted);
      font-weight: 700;
      text-align: center;
    }

    .hud-box strong {
      display: block;
      margin-top: 6px;
      font-size: clamp(1.2rem, 2vw, 1.7rem);
      color: var(--gold);
      text-shadow: 0 0 18px rgba(255, 184, 73, 0.35);
    }

    .machine-wrap {
      padding: 2px 22px 0;
      position: relative;
      z-index: 1;
    }

    .machine {
      background:
        linear-gradient(180deg, #18181b 0%, #121216 100%);
      border: 2px solid rgba(255, 88, 100, 0.9);
      border-radius: 28px;
      box-shadow:
        inset 0 0 30px rgba(0,0,0,0.7),
        0 0 30px rgba(255, 59, 77, 0.14);
      padding: 18px;
      position: relative;
      overflow: hidden;
    }

    .machine::before {
      content: "";
      position: absolute;
      inset: 12px;
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 20px;
      pointer-events: none;
    }

    .reels {
      position: relative;
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 8px;
      padding: 12px;
      border-radius: 18px;
      background: rgba(6,7,11,0.82);
      box-shadow: inset 0 0 25px rgba(0,0,0,0.6);
      min-height: 420px;
    }

    .reel {
      display: grid;
      gap: 8px;
      padding: 8px;
      border-radius: 14px;
      background: linear-gradient(180deg, rgba(38, 20, 24, 0.9), rgba(11,12,18,0.9));
      border: 1px solid rgba(255,255,255,0.04);
    }

    .symbol {
      display: grid;
      place-items: center;
      min-height: 76px;
      border-radius: 12px;
      background: linear-gradient(180deg, rgba(41,38,44,0.96), rgba(18,18,24,0.96));
      border: 1px solid rgba(255,255,255,0.08);
      font-size: clamp(1.7rem, 5vw, 3rem);
      box-shadow: inset 0 0 10px rgba(255,255,255,0.03);
      transition: transform 0.18s ease, box-shadow 0.18s ease, border 0.18s ease;
    }

    .symbol.win {
      background: linear-gradient(180deg, rgba(93,70,18,0.92), rgba(39,28,14,0.92));
      border-color: rgba(255,215,122,0.8);
      box-shadow:
        0 0 18px rgba(255,215,122,0.34),
        inset 0 0 18px rgba(255,215,122,0.12);
      transform: scale(1.03);
    }

    .payline {
      position: absolute;
      inset: 0;
      z-index: 3;
      pointer-events: none;
      width: 100%;
      height: 100%;
    }

    .payline line {
      stroke: #ffef9a;
      stroke-width: 6;
      stroke-linecap: round;
      filter: drop-shadow(0 0 6px rgba(255, 215, 122, 0.8))
              drop-shadow(0 0 12px rgba(255, 59, 77, 0.6));
      stroke-dasharray: 1500;
      stroke-dashoffset: 1500;
    }

    .payline.show line {
      animation: draw-line .45s ease-out forwards, pulse-line .7s ease-in-out .45s infinite alternate;
    }

    @keyframes draw-line {
      to { stroke-dashoffset: 0; }
    }

    @keyframes pulse-line {
      from { opacity: .7; }
      to { opacity: 1; }
    }

    .message {
      min-height: 62px;
      display: grid;
      place-items: center;
      text-align: center;
      padding: 16px 22px 0;
      font-weight: 800;
      color: var(--gold);
      text-shadow: 0 0 12px rgba(255,215,122,0.25);
      position: relative;
      z-index: 1;
    }

    .picker {
      padding: 18px 22px 6px;
      position: relative;
      z-index: 1;
    }

    .picker-title {
      margin: 0 0 12px;
      text-align: center;
      color: var(--muted);
      font-size: 0.7rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-weight: 800;
    }

    .choices {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
    }

    .choice {
      padding: 12px 8px;
      border-radius: 12px;
      border: 1px solid rgba(255,255,255,0.14);
      background: linear-gradient(180deg, #1f1d20, #121317);
      color: var(--white);
      font-weight: 800;
      cursor: pointer;
      transition: transform 0.16s ease, border-color 0.16s ease, background 0.16s ease;
    }

    .choice:hover {
      border-color: rgba(255,93,105,0.9);
      transform: translateY(-1px);
    }

    .choice.selected {
      background: linear-gradient(180deg, #5a1824, #2b1115);
      border-color: rgba(255, 93, 105, 0.9);
      box-shadow: 0 0 20px rgba(255, 59, 77, 0.2);
      color: #fff;
    }

    .controls {
      display: flex;
      justify-content: center;
      padding: 18px 22px 22px;
      position: relative;
      z-index: 1;
    }

    #start {
      min-width: 220px;
      border: 0;
      border-radius: 999px;
      padding: 18px 28px;
      font-weight: 900;
      font-size: 1rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #fff;
      cursor: pointer;
      background: linear-gradient(180deg, #ff4d5d 0%, #b0182a 100%);
      box-shadow:
        0 7px 0 #5d0d17,
        0 14px 28px rgba(255, 59, 77, 0.25);
      transition: transform 0.15s ease, filter 0.2s ease;
    }

    #start:hover:not(:disabled) {
      transform: translateY(-2px);
      filter: brightness(1.08);
    }

    #start:active:not(:disabled) {
      transform: translateY(2px);
      box-shadow:
        0 3px 0 #5d0d17,
        0 8px 20px rgba(255, 59, 77, 0.2);
    }

    #start:disabled {
      opacity: 0.7;
      cursor: wait;
    }

    .rules {
      margin: 0 22px 18px;
      padding: 14px 16px;
      border-radius: 14px;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.08);
      color: var(--muted);
      font-size: 0.85rem;
      line-height: 1.6;
      position: relative;
      z-index: 1;
    }

    .rules strong {
      color: var(--green);
    }

    .footer-note {
      padding: 0 0 20px;
      color: rgba(255,255,255,0.36);
      text-align: center;
      font-size: 0.62rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      position: relative;
      z-index: 1;
    }

    @media (max-width: 720px) {
      .topbar {
        flex-direction: column;
        text-align: center;
      }

      .hud {
        grid-template-columns: 1fr 1fr 1fr;
      }

      .choices {
        grid-template-columns: repeat(2, minmax(120px, 1fr));
      }

      .reels {
        min-height: 300px;
      }

      .symbol {
        min-height: 52px;
      }
    }
  </style>
</head>
<body>
  <main class="slot">
    <div class="topbar">
      <div class="brand">J2PG</div>
      <div class="title-wrap">
        <h1>J2PG</h1>
        <div class="subtitle">Casino de la nuit</div>
      </div>
      <div class="brand">Casino</div>
    </div>

    <div class="hud">
      <div class="hud-box">
        Points fictifs
        <strong id="score">5000</strong>
      </div>
      <div class="hud-box">
        Spins restants
        <strong id="remaining">—</strong>
      </div>
      <div class="hud-box">
        Gain du spin
        <strong id="spinGain">0</strong>
      </div>
    </div>

    <div class="machine-wrap">
      <div class="machine">
        <div class="reels" id="reels">
          <svg class="payline" id="payline" viewBox="0 0 1000 500" preserveAspectRatio="none" aria-hidden="true">
            <line x1="20" y1="250" x2="980" y2="250"></line>
          </svg>
        </div>
      </div>
    </div>

    <div class="message" id="message" aria-live="polite">
      Choisis ton nombre de spins puis lance la partie.
    </div>

    <div class="picker">
      <p class="picker-title">Nombre de spins</p>
      <div class="choices">
        <button class="choice selected" type="button" data-count="10" aria-pressed="true">10</button>
        <button class="choice" type="button" data-count="20" aria-pressed="false">20</button>
        <button class="choice" type="button" data-count="30" aria-pressed="false">30</button>
        <button class="choice" type="button" data-count="50" aria-pressed="false">50</button>
      </div>
    </div>

    <div class="controls">
      <button id="start" type="button">Start</button>
    </div>

    <div class="rules">
      <strong>Règles :</strong> chaque spin coûte 10 points fictifs. Les 5 symboles identiques de la rangée centrale donnent un gain. Un jackpot spécial est déclenché si les 5 symboles du centre sont identiques. Aucun achat ni argent réel.
    </div>

    <div class="footer-note">Prototype de démonstration</div>
  </main>

  <script>
    const symbols = ["🕷️", "💀", "🕯️", "🦇", "👁️", "🌙"];
    const rewards = {
      "🕷️": 150,
      "💀": 500,
      "🕯️": 250,
      "🦇": 300,
      "👁️": 400,
      "🌙": 200
    };

    const reelsElement = document.getElementById("reels");
    const scoreElement = document.getElementById("score");
    const remainingElement = document.getElementById("remaining");
    const spinGainElement = document.getElementById("spinGain");
    const messageElement = document.getElementById("message");
    const paylineElement = document.getElementById("payline");
    const startButton = document.getElementById("start");
    const choiceButtons = [...document.querySelectorAll(".choice")];

    let score = 5000;
    let selectedCount = 10;
    let busy = false;

    function randomSymbol() {
      return symbols[Math.floor(Math.random() * symbols.length)];
    }

    function makeGrid() {
      return Array.from({ length: 5 }, () =>
        Array.from({ length: 5 }, randomSymbol)
      );
    }

    function drawGrid(grid, isWin = false) {
      reelsElement.querySelectorAll(".reel").forEach(reel => reel.remove());
      paylineElement.classList.remove("show");

      for (let column = 0; column < 5; column++) {
        const reel = document.createElement("div");
        reel.className = "reel";

        for (let row = 0; row < 5; row++) {
          const cell = document.createElement("div");
          cell.className = "symbol";
          cell.textContent = grid[row][column];

          if (isWin && row === 2) {
            cell.classList.add("win");
          }

          reel.appendChild(cell);
        }

        reelsElement.appendChild(reel);
      }

      if (isWin) {
        requestAnimationFrame(() => paylineElement.classList.add("show"));
      }
    }

    function updateStatus(remaining = "\u2014") {
      scoreElement.textContent = score;
      remainingElement.textContent = remaining;
    }

    function wait(ms) {
      return new Promise(resolve => setTimeout(resolve, ms));
    }

    async function playOneSpin(index, total) {
      score -= 10;
      spinGainElement.textContent = "0";
      updateStatus(`${total - index + 1} / ${total}`);
      messageElement.textContent = `La crypte s'agite... Spin ${index}/${total}`;

      for (let tick = 0; tick < 7; tick++) {
        drawGrid(makeGrid());
        await wait(85);
      }

      const grid = makeGrid();
      const middleRow = grid[2];
      const isJackpot = middleRow.every(symbol => symbol === middleRow[0]);

      const isWin = isJackpot;

      if (isWin) {
        const gain = rewards[middleRow[0]] || 500;
        score += gain;
        spinGainElement.textContent = `+${gain}`;
        drawGrid(grid, true);
        messageElement.textContent = `Jackpot ! +${gain} points fictifs — ligne centrale connectée !`;
      } else {
        drawGrid(grid);
        messageElement.textContent = "Aucun gain sur ce spin. Les ombres restent silencieuses...";
      }

      updateStatus(`${total - index} / ${total}`);
      await wait(700);
    }

    async function startGame() {
      if (busy) return;

      const affordableSpins = Math.floor(score / 10);
      const total = Math.min(selectedCount, affordableSpins);

      if (total < 1) {
        messageElement.textContent = "Plus assez de points fictifs pour jouer.";
        return;
      }

      busy = true;
      startButton.disabled = true;
      choiceButtons.forEach(btn => btn.disabled = true);

      if (total < selectedCount) {
        messageElement.textContent = `Tu as assez pour ${total} spin(s) sur ${selectedCount}.`;
        await wait(900);
      }

      for (let index = 1; index <= total; index++) {
        await playOneSpin(index, total);
      }

      busy = false;
      startButton.disabled = false;
      choiceButtons.forEach(btn => btn.disabled = false);

      updateStatus("\u2014");
      messageElement.textContent = score >= 10
        ? "Session terminée. La crypte t’attend encore..."
        : "Session terminée : plus assez de points fictifs.";

      drawGrid(makeGrid());
    }

    choiceButtons.forEach(button => {
      button.addEventListener("click", () => {
        if (busy) return;

        selectedCount = Number(button.dataset.count);

        choiceButtons.forEach(btn => {
          const isSelected = btn === button;
          btn.classList.toggle("selected", isSelected);
          btn.setAttribute("aria-pressed", String(isSelected));
        });

        messageElement.textContent = `${selectedCount} spins sélectionnés. Appuie sur Start.`;
      });
    });

    startButton.addEventListener("click", startGame);

    drawGrid(makeGrid());
    updateStatus();
  </script>
</body>
</html>
